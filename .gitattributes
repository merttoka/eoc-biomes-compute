*.f16 filter=lfs diff=lfs merge=lfs -text

# Everything under biomes11/ goes to LFS regardless of extension...
Assets/StreamingAssets/biomes11/** filter=lfs diff=lfs merge=lfs -text
# ...except Unity .meta files, which must stay diffable/mergeable text.
Assets/StreamingAssets/biomes11/**/*.meta -filter -diff -merge text
