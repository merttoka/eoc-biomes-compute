// Biome environment field system
// Multi-channel persistent fields with diffusion, advection, cross-field interactions

#pragma kernel ResetFieldsKernel
#pragma kernel InitPermeabilityKernel
#pragma kernel DiffuseFieldsKernel
#pragma kernel InteractFieldsKernel
#pragma kernel AdvectFieldsKernel
#pragma kernel GenerateFlowKernel
#pragma kernel RenderDebugKernel
#pragma kernel WriteFieldKernel
#pragma kernel InjectStampKernel
#pragma kernel ReadFieldKernel
#pragma kernel BuildPermeabilityKernel
#pragma kernel SeedChannelKernel

#include "includes/random.hlsl"
#include "includes/color.hlsl"

// --- Channel indices (must match BiomeChannel C# enum) ---
#define CH_NUTRIENT     0
#define CH_PHEROMONE0   1
#define CH_PHEROMONE1   2
#define CH_PHEROMONE2   3
#define CH_OXYGEN       4
#define CH_TEMPERATURE  5
#define CH_WASTE        6
#define CH_PERMEABILITY 7
#define CH_FLOW_X       8
#define CH_FLOW_Y       9
#define CH_DISPERSAL    10
#define CH_HUMIDITY     11
#define CH_HUMIDITY_GRAD 12
#define CH_EXCITABILITY 13
#define CH_SUBSTRATE    14
#define CH_COUNT        15

// --- Textures ---
SamplerState sampler_fieldRead;
Texture2DArray<float> fieldRead;
RWTexture2DArray<float> fieldWrite;
RWTexture2D<float4> debugOutTex;

// --- Uniforms ---
uint rezX;
uint rezY;
uint channelCount;

// Per-channel settings buffer: float4(diffuseRate, decayRate, advectedByFlow, initialValue)
StructuredBuffer<float4> channelSettings;
// Parallel per-channel homeostatic relaxation rate (relax toward initialValue baseline, or
// for permeability toward the recomputed noise terrain). 0 = off (old one-way behaviour).
StructuredBuffer<float> channelRelax;
// Parallel per-channel diffusion-kernel shaping: float4(kernelShape, flowAnisotropy,
// permeabilityInfluence, reserved). An all-zero row reproduces the legacy uniform 3x3
// box blur exactly — see DiffuseFieldsKernel for what each term does.
StructuredBuffer<float4> channelKernel;

// Cross-field interaction params
float wasteToNutrientRate;
float decompTempSpan;       // Q10 exponent span for decomposition (0 ≈ flat, ~4 = strong fronts)
float tempToFlowStrength;
float windX;                // ambient wind added into the flow accumulation each step
float windY;                // (prevailing drift; flow equilibrium ≈ 10x this, clamped ±1)
float tempToPermeability;
float tempToEvaporation;    // Temperature above 0.5 baseline sinks Humidity (evaporation)
float humidityGradientGain; // |∇Humidity| magnitude gain (raw grad tiny; Humidity diffuseRate smooths it)
float permOpenBaseline;      // open-ground permeability; termite mounds build downward from it
float noiseScale;
float noiseThreshold;

// Debug
int debugChannel;
// Export-only contrast stretch: when debugNormalize != 0, val -> (val-min)*invRange
// before the colormap, so faint channels become visible. Realtime paths leave it 0.
int debugNormalize;
float debugNormMin;
float debugNormInvRange;

// Write API
int writeChannel;
float writeAmount;
uint agentCount;
float simToFieldX;
float simToFieldY;
// Matches the 20-byte Agent layout shared by all sims (position, direction, typeId).
// Declared as the full struct (not StructuredBuffer<float2>) so the element stride is
// 20 bytes and agentPositions[i].position reads the correct bytes on every backend
// (Metal addresses structured buffers by the shader-side element size).
struct AgentPos {
    float2 position;
    float2 direction;
    uint typeId;
};
StructuredBuffer<AgentPos> agentPositions;

// Inject API (external spatial sources → biome channels; see BiomeInjector.cs)
struct InjectStamp {
    float2 uv;       // 0..1 biome-space center
    float radius;    // falloff radius in uv units
    float falloff;   // edge power (1=linear, >1=sharper core)
    int   channel;   // target biome channel
    float amount;    // gain * live value (precomputed CPU-side)
    int   mode;      // 0=additive, 1=max-toward, 2=set-toward
    float _pad;
};
StructuredBuffer<InjectStamp> injectStamps;
uint injectStampCount;

// Read API (perception)
struct ReadEntry {
    int channel;
    float weight;
    int effect;
    float _pad;
};
StructuredBuffer<ReadEntry> readEntries;
int readEntryCount;
uint perceptionRezX;
uint perceptionRezY;
RWTexture2D<float4> perceptionTex;

// Habitat confinement (per-species preferred permeability band)
float habitatBandMin;    // this species' preferred permeability band (min)
float habitatBandMax;    // ... (max)
float habitatAvoidGain;  // out-of-band -> avoidance
float habitatSlowGain;   // out-of-band -> speed penalty
float habitatSpeedFloor; // min speed multiplier out-of-band (never fully freeze; builders must roam)


// Partial field passes (flow/advect/interact) write only a subset of channels.
// Calling this first preserves the untouched channels across the ping-pong swap
// between passes (see Biome.cs Step). Each thread owns one cell, so no races.
void CopyAllChannels(uint2 xy) {
    for (uint cc = 0; cc < CH_COUNT; cc++)
        fieldWrite[uint3(xy, cc)] = fieldRead[uint3(xy, cc)];
}


// ════════════════════════════════════════════════
// RESET
// ════════════════════════════════════════════════
[numthreads(8, 8, 1)]
void ResetFieldsKernel(uint3 id : SV_DISPATCHTHREADID) {
    if (id.x >= rezX || id.y >= rezY) return;
    for (uint c = 0; c < CH_COUNT; c++) {
        fieldWrite[uint3(id.xy, c)] = channelSettings[c].w; // initialValue
    }
}

[numthreads(8, 8, 1)]
void InitPermeabilityKernel(uint3 id : SV_DISPATCHTHREADID) {
    if (id.x >= rezX || id.y >= rezY) return;
    // Uniform-open baseline: agent-authored termite mounds replace the static noise terrain.
    fieldWrite[uint3(id.xy, CH_PERMEABILITY)] = permOpenBaseline;
}


// ════════════════════════════════════════════════
// GENERATE FLOW FROM TEMPERATURE GRADIENTS
// ════════════════════════════════════════════════
[numthreads(8, 8, 1)]
void GenerateFlowKernel(uint3 id : SV_DISPATCHTHREADID) {
    if (id.x >= rezX || id.y >= rezY) return;

    CopyAllChannels(id.xy); // flow channels are overwritten below

    float2 uv = float2((id.x + 0.5) / (float)rezX, (id.y + 0.5) / (float)rezY);
    float dx = 1.0 / (float)rezX;
    float dy = 1.0 / (float)rezY;

    // Temperature gradient (central differences)
    float tL = fieldRead.SampleLevel(sampler_fieldRead, float3(uv.x - dx, uv.y, CH_TEMPERATURE), 0);
    float tR = fieldRead.SampleLevel(sampler_fieldRead, float3(uv.x + dx, uv.y, CH_TEMPERATURE), 0);
    float tD = fieldRead.SampleLevel(sampler_fieldRead, float3(uv.x, uv.y - dy, CH_TEMPERATURE), 0);
    float tU = fieldRead.SampleLevel(sampler_fieldRead, float3(uv.x, uv.y + dy, CH_TEMPERATURE), 0);

    float gradX = (tR - tL) * 0.5;
    float gradY = (tU - tD) * 0.5;

    // Existing flow + temperature contribution (accumulate, don't replace)
    float existingFX = fieldRead[uint3(id.xy, CH_FLOW_X)];
    float existingFY = fieldRead[uint3(id.xy, CH_FLOW_Y)];

    // Flow = temperature gradient rotated 90° → circulation around hot/cold spots,
    // plus the ambient wind. The curl term is mean-zero (no buoyancy bias): any
    // preferred drift direction comes ONLY from the wind, which accumulates against
    // the flow channels' 0.92 diffuse-leak · 0.98 decay to an equilibrium ≈ 10x the
    // per-step add before the ±1 clamp — so windX/windY live in the ~±0.1 range.
    float newFX = existingFX + (-gradY) * tempToFlowStrength + windX;
    float newFY = existingFY + ( gradX) * tempToFlowStrength + windY;

    fieldWrite[uint3(id.xy, CH_FLOW_X)] = clamp(newFX, -1, 1);
    fieldWrite[uint3(id.xy, CH_FLOW_Y)] = clamp(newFY, -1, 1);
}


// ════════════════════════════════════════════════
// ADVECT SCALAR FIELDS BY FLOW
// ════════════════════════════════════════════════
[numthreads(8, 8, 1)]
void AdvectFieldsKernel(uint3 id : SV_DISPATCHTHREADID) {
    if (id.x >= rezX || id.y >= rezY) return;

    CopyAllChannels(id.xy); // advected channels are overwritten below

    float2 uv = float2((id.x + 0.5) / (float)rezX, (id.y + 0.5) / (float)rezY);

    // Read flow at this position
    float fx = fieldRead[uint3(id.xy, CH_FLOW_X)];
    float fy = fieldRead[uint3(id.xy, CH_FLOW_Y)];

    // Semi-Lagrangian advection: trace backward along flow
    float2 srcUV = uv - float2(fx, fy) / float2((float)rezX, (float)rezY);

    // Advect channels marked as advectable
    for (uint c = 0; c < CH_COUNT; c++) {
        float isAdvected = channelSettings[c].z; // advectedByFlow
        if (isAdvected > 0.5) {
            float advected = fieldRead.SampleLevel(sampler_fieldRead, float3(srcUV, c), 0);
            float current = fieldRead[uint3(id.xy, c)];
            // Blend: mostly advected, slight retention of current value
            fieldWrite[uint3(id.xy, c)] = lerp(current, advected, 0.8);
        }
    }
}


// ════════════════════════════════════════════════
// CROSS-FIELD INTERACTIONS
// ════════════════════════════════════════════════
[numthreads(8, 8, 1)]
void InteractFieldsKernel(uint3 id : SV_DISPATCHTHREADID) {
    if (id.x >= rezX || id.y >= rezY) return;

    CopyAllChannels(id.xy); // nutrient/waste/permeability are overwritten below

    float nutrient = fieldRead[uint3(id.xy, CH_NUTRIENT)];
    float waste    = fieldRead[uint3(id.xy, CH_WASTE)];
    float temp     = fieldRead[uint3(id.xy, CH_TEMPERATURE)];
    float perm     = fieldRead[uint3(id.xy, CH_PERMEABILITY)];
    float humidity = fieldRead[uint3(id.xy, CH_HUMIDITY)];

    // 1. Waste decomposition → nutrient. Q10: near-frozen when cold, explosive when hot
    //    (rate = base·2.74^((temp-0.5)·span)), so fertility tracks the hot zones and travels
    //    with them instead of ramping uniformly. Clamped, and bounded by available waste.
    float decompRate = wasteToNutrientRate * pow(2.74, (temp - 0.5) * decompTempSpan);
    decompRate = min(decompRate, 0.5);
    float decomposed = min(waste, decompRate);
    nutrient += decomposed;
    waste -= decomposed;

    // 2. Temperature → permeability as a BOUNDED, relaxing target (not an accumulator).
    float relaxPerm = channelRelax[CH_PERMEABILITY];
    if (relaxPerm > 0.0) {
        // Relax toward uniform-open so built walls slowly heal to open ground, not to a fixed
        // noise terrain. Temperature coupling retained but tuned to ~0 (asset).
        float permTarget = saturate(permOpenBaseline + (temp - 0.5) * tempToPermeability);
        perm = lerp(perm, permTarget, relaxPerm);
    } else {
        perm = clamp(perm + (temp - 0.5) * tempToPermeability, 0, 1);
    }

    // 3. Temperature → Humidity evaporation. Heat above the 0.5 baseline drives moisture off,
    //    so a hot zone leaves a drying wake behind it; Humidity's relaxRate then refills the
    //    cooled ground (renewable, depletable). The steep edge between dry hot zones and humid
    //    cool ground is the |∇Humidity| termite build cue (sampled agent-side via perception).
    humidity -= tempToEvaporation * max(0.0, temp - 0.5);

    // 4. |∇Humidity| → CH_HUMIDITY_GRAD. Central differences on PRE-evaporation Humidity: the
    //    neighbour taps sample fieldRead, which the evaporation above never touched (it only
    //    decremented the local `humidity`), so this encodes the sharpest drying-wake edge.
    //    Reads center-neighbours, writes its own cell only → race-free. This channel's
    //    diffuseRate is 0 so DiffuseFieldsKernel won't blur the edge it encodes.
    float2 uv = float2((id.x + 0.5) / (float)rezX, (id.y + 0.5) / (float)rezY);
    float dx = 1.0 / (float)rezX;
    float dy = 1.0 / (float)rezY;
    float hL = fieldRead.SampleLevel(sampler_fieldRead, float3(uv.x - dx, uv.y, CH_HUMIDITY), 0);
    float hR = fieldRead.SampleLevel(sampler_fieldRead, float3(uv.x + dx, uv.y, CH_HUMIDITY), 0);
    float hD = fieldRead.SampleLevel(sampler_fieldRead, float3(uv.x, uv.y - dy, CH_HUMIDITY), 0);
    float hU = fieldRead.SampleLevel(sampler_fieldRead, float3(uv.x, uv.y + dy, CH_HUMIDITY), 0);
    float gradX = (hR - hL) * 0.5;
    float gradY = (hU - hD) * 0.5;

    fieldWrite[uint3(id.xy, CH_NUTRIENT)] = clamp(nutrient, 0, 1);
    fieldWrite[uint3(id.xy, CH_WASTE)] = clamp(waste, 0, 1);
    fieldWrite[uint3(id.xy, CH_PERMEABILITY)] = perm;
    fieldWrite[uint3(id.xy, CH_HUMIDITY)] = clamp(humidity, 0, 1);
    fieldWrite[uint3(id.xy, CH_HUMIDITY_GRAD)] = saturate(length(float2(gradX, gradY)) * humidityGradientGain);
}


// ════════════════════════════════════════════════
// DIFFUSE & DECAY
// ════════════════════════════════════════════════
// The 3x3 neighbourhood average feeding both diffusion classes (ADR-0007) is a
// NORMALIZED weighted average; per-channel channelKernel rows shape the weights:
//   .x kernelShape          0 = box (legacy), 1 = gaussian 1,2,1 ⊗ 1,2,1 (less
//                           diagonal bias); fractional values morph between them
//   .y flowAnisotropy       0..1: elongate the kernel along the local flow vector,
//                           scaled by |flow| (turbulent eddy diffusivity — plumes
//                           stretch along the wind). SYMMETRIC up/downwind by design:
//                           the one-way drift is AdvectFieldsKernel's job.
//   .z permeabilityInfluence 0..1: gate each neighbour exchange by the interface
//                           permeability min(perm_here, perm_there) — porous media.
//                           Termite walls block scent, chambers pool it, corridors
//                           duct it; a sealed cell keeps its load until it decays.
// An all-zero row makes every weight 1 → the legacy box blur (identical up to
// float summation order; wsum is exactly 9.0 there).
// Weights are NORMALIZED, so a uniform field still maps to itself — the invariant
// ADR-0007's relax-channel equilibrium (== baseline) depends on. What is lost with
// spatially varying weights is exact GLOBAL mass conservation (gather ≠ scatter):
// accepted, since stigmergic channels leak by design and relax channels are pinned
// to their baseline. See docs/superpowers/specs/2026-08-10-anisotropic-diffusion.
static const float GAUSS_W[9] = { 1, 2, 1, 2, 4, 2, 1, 2, 1 };

[numthreads(8, 8, 1)]
void DiffuseFieldsKernel(uint3 id : SV_DISPATCHTHREADID) {
    if (id.x >= rezX || id.y >= rezY) return;

    // Channel-independent per-cell tap data, hoisted out of the channel loop.
    // Taps are TOROIDALLY WRAPPED integer Loads: the field textures are Repeat-wrapped
    // (GPUResourceManager), so the old SampleLevel blur wrapped at the edges; integer
    // modulo reproduces that exactly (agents wrap too — the world is a torus).
    int2  taps[9];     // wrapped coords, row-major (dy outer, dx inner) to match GAUSS_W
    float align2[9];   // (tap dir · flow dir)^2; 1 for the center tap (never penalized)
    float permIf[9];   // interface permeability toward each tap; 1 for the center

    float2 flow = float2(fieldRead[uint3(id.xy, CH_FLOW_X)],
                         fieldRead[uint3(id.xy, CH_FLOW_Y)]);
    float flowMag = length(flow);
    float2 flowDir = flowMag > 1e-5 ? flow / flowMag : float2(0, 0);
    float permHere = fieldRead[uint3(id.xy, CH_PERMEABILITY)];

    uint t = 0;
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            int2 xy = (int2(id.xy) + int2(dx, dy) + int2(rezX, rezY)) % int2(rezX, rezY);
            taps[t] = xy;
            if (dx == 0 && dy == 0) {
                align2[t] = 1.0;
                permIf[t] = 1.0;
            } else {
                float2 dir = normalize(float2(dx, dy));
                float a = dot(dir, flowDir);
                align2[t] = a * a;
                permIf[t] = min(permHere, fieldRead[uint3(xy, CH_PERMEABILITY)]);
            }
            t++;
        }
    }

    for (uint c = 0; c < CH_COUNT; c++) {
        float diffuseRate = channelSettings[c].x;
        float decayRate = channelSettings[c].y;

        // Skip channels that don't diffuse (e.g. permeability, CA-owned channels)
        if (diffuseRate <= 0.0) {
            fieldWrite[uint3(id.xy, c)] = fieldRead[uint3(id.xy, c)];
            continue;
        }

        float4 kern = channelKernel[c];
        // Anisotropy scales with flow speed: still air diffuses isotropically no
        // matter the knob — eddy diffusivity grows with wind shear.
        float elong = kern.y * saturate(flowMag);

        float acc = 0;
        float wsum = 0;
        [unroll]
        for (uint i = 0; i < 9; i++) {
            float w = lerp(1.0, GAUSS_W[i], saturate(kern.x))
                    * lerp(1.0, align2[i], elong)
                    * lerp(1.0, permIf[i], saturate(kern.z));
            acc += w * fieldRead[uint3(taps[i], c)];
            wsum += w;
        }
        float avg = acc / wsum; // wsum >= 1: the center tap is never down-weighted

        float baseline = channelSettings[c].w;
        float relaxRate = channelRelax[c];

        // avg*diffuseRate leaks (1-diffuseRate) of the whole field per step. For
        // pheromone channels (relaxRate 0) that leak IS the trail evaporation; for
        // homeostatic channels it drags the equilibrium below the baseline
        // (x* = r*b / (1-(1-r)*d*(1-k)), e.g. Oxygen 0.535 instead of 0.8), so they
        // get mass-conserving mixing instead: a uniform field maps to itself.
        float diffused;
        if (relaxRate > 0.0) {
            float center = fieldRead[uint3(id.xy, c)];
            diffused = lerp(center, avg, diffuseRate);
        } else {
            diffused = avg * diffuseRate;
        }
        float decayed = diffused * (1.0 - decayRate);
        // Homeostatic relaxation toward the ambient baseline (= initialValue). For
        // consumed channels (Oxygen) this replenishes; for accumulating ones
        // (Temperature) it caps — a dynamic equilibrium proportional to local agent
        // density instead of a one-way ramp to flat 1.0. relaxRate 0 = identity.
        float relaxed = lerp(decayed, baseline, relaxRate);
        fieldWrite[uint3(id.xy, c)] = clamp(relaxed, 0, 1);
    }
}


// ════════════════════════════════════════════════
// WRITE FIELD (sim agents → biome)
// ════════════════════════════════════════════════
[numthreads(1024, 1, 1)]
void WriteFieldKernel(uint3 id : SV_DISPATCHTHREADID) {
    if (id.x >= agentCount) return;

    float2 simPos = agentPositions[id.x].position;
    uint2 fieldPos = uint2(
        clamp(simPos.x * simToFieldX, 0, rezX - 1),
        clamp(simPos.y * simToFieldY, 0, rezY - 1)
    );

    float current = fieldWrite[uint3(fieldPos, writeChannel)];
    fieldWrite[uint3(fieldPos, writeChannel)] = clamp(current + writeAmount, 0, 1);
}


// ════════════════════════════════════════════════
// TERMITE MOUND BUILD (probabilistic, firing-gated permeability lowering)
// ════════════════════════════════════════════════
StructuredBuffer<float> buildFiring;   // per-neuron firing intensity (shared source)
uint  buildNeuronCount;
float buildDepositProb;                // baseline per-step build chance
float buildFiringDepositProb;          // build chance when the agent's neuron is firing
float buildFiringThreshold;            // firing intensity above which the firing chance applies
float buildAmount;                     // permeability lowered per build event (positive)
uint  buildTimeSeed;                   // per-step seed for the per-agent RNG

float BuildHash(uint a, uint b) {
    uint h = a * 747796405u + b * 2891336453u;
    h = (h ^ (h >> 16)) * 2246822519u;
    h = (h ^ (h >> 13)) * 3266489917u;
    h ^= h >> 16;
    return (h & 0x00FFFFFFu) / 16777216.0;   // 0..1
}

[numthreads(256, 1, 1)]
void BuildPermeabilityKernel(uint3 id : SV_DISPATCHTHREADID) {
    if (id.x >= agentCount) return;
    float2 simPos = agentPositions[id.x].position;
    uint2 fieldPos = uint2(
        clamp(simPos.x * simToFieldX, 0, rezX - 1),
        clamp(simPos.y * simToFieldY, 0, rezY - 1)
    );
    // Build pulses with the agent's neuron (agent i -> neuron i % neuronCount).
    float firing = buildNeuronCount > 0 ? buildFiring[id.x % buildNeuronCount] : 0.0;
    float prob = firing > buildFiringThreshold ? buildFiringDepositProb : buildDepositProb;
    if (BuildHash(id.x, buildTimeSeed) < prob) {
        float current = fieldWrite[uint3(fieldPos, CH_PERMEABILITY)];
        fieldWrite[uint3(fieldPos, CH_PERMEABILITY)] = clamp(current - buildAmount, 0, 1);
    }
}


// ════════════════════════════════════════════════
// INJECT EXTERNAL SOURCES → biome channels
// Runs pre-Step, in-place into fieldRead (bound as fieldWrite) — like WriteField,
// so it rides the field ping-pong with no clobber risk. Soft Gaussian discs.
// ════════════════════════════════════════════════
[numthreads(8, 8, 1)]
void InjectStampKernel(uint3 id : SV_DISPATCHTHREADID) {
    if (id.x >= rezX || id.y >= rezY) return;

    float2 uv = float2((id.x + 0.5) / (float)rezX, (id.y + 0.5) / (float)rezY);
    float aspect = (float)rezX / (float)rezY;

    for (uint s = 0; s < injectStampCount; s++) {
        InjectStamp st = injectStamps[s];
        if (st.radius <= 0) continue;
        float2 d = uv - st.uv;
        d.x *= aspect;                 // keep discs round on non-square fields
        float dist = length(d);
        if (dist >= st.radius) continue;

        float w = pow(saturate(1.0 - dist / st.radius), max(st.falloff, 1e-3));
        uint3 c = uint3(id.xy, (uint)st.channel);
        float cur = fieldWrite[c];

        if (st.mode == 1)       fieldWrite[c] = max(cur, saturate(st.amount * w)); // max-toward (stable gradient)
        else if (st.mode == 2)  fieldWrite[c] = saturate(lerp(cur, st.amount, w)); // set-toward
        else if (st.mode == 3)  fieldWrite[c] = lerp(cur, min(cur, saturate(st.amount)), w); // min-toward (one-way close)
        else                    fieldWrite[c] = saturate(cur + st.amount * w);     // additive
    }
}


// ════════════════════════════════════════════════
// SEED CHANNEL FROM TEXTURE
// ════════════════════════════════════════════════
// Raster -> channel. The one texture-driven write path in the biome: every other kernel
// writes from agent-position buffers or stamps radial blobs from a point+radius+falloff,
// so neither can ingest an image. Two consumers share this: the Shanghai built-up transect
// seeding Permeability, and a FieldSimulationBase publishing its cellular-automaton state
// into its own channel.
//
// Sampled through an explicit linear-CLAMP sampler rather than the source texture's own
// settings. Clamp matters: the CA state textures are Repeat-wrapped for the rule's toroidal
// neighbourhood, and inheriting that here would wrap the Shanghai strip's far edge back into
// frame. Linear matters because the source is usually a different resolution than the field.
Texture2D<float4> seedTex;
SamplerState sampler_linear_clamp;
int   seedChannel;
float seedGain;
int   seedMode;      // matches BiomeInjector.BlendMode: 0 add, 1 max, 2 set, 3 min

[numthreads(8, 8, 1)]
void SeedChannelKernel(uint3 id : SV_DISPATCHTHREADID) {
    if (id.x >= rezX || id.y >= rezY) return;

    float2 uv = (float2(id.xy) + 0.5) / float2((float)rezX, (float)rezY);
    float v = saturate(seedTex.SampleLevel(sampler_linear_clamp, uv, 0).r * seedGain);

    uint3 c = uint3(id.xy, (uint)seedChannel);
    float cur = fieldWrite[c];

    // No falloff term here — the texture IS the spatial weight, so each mode applies at
    // full strength per texel. That makes set-toward an overwrite and min-toward a hard
    // ceiling, which is exactly what a monotonic closure seed wants.
    if (seedMode == 1)      fieldWrite[c] = max(cur, v);
    else if (seedMode == 2) fieldWrite[c] = v;
    else if (seedMode == 3) fieldWrite[c] = min(cur, v);
    else                    fieldWrite[c] = saturate(cur + v);
}


// ════════════════════════════════════════════════
// READ FIELD → PERCEPTION TEXTURE
// ════════════════════════════════════════════════
[numthreads(8, 8, 1)]
void ReadFieldKernel(uint3 id : SV_DISPATCHTHREADID) {
    if (id.x >= perceptionRezX || id.y >= perceptionRezY) return;

    // Map sim-space pixel → biome UV
    float2 uv = float2((id.x + 0.5) / (float)perceptionRezX, (id.y + 0.5) / (float)perceptionRezY);

    // Accumulate weighted biome channels into perception
    // R = chemotaxis signal, G = speed multiplier, B = avoidance signal, A = speed boost
    float chemotaxis = 0;
    float speedMod = 1.0;
    float avoidance = 0;
    float boost = 0;

    for (int i = 0; i < readEntryCount; i++) {
        ReadEntry entry = readEntries[i];
        float val = fieldRead.SampleLevel(sampler_fieldRead, float3(uv, entry.channel), 0);
        float weighted = val * entry.weight;

        // effect: 0=chemotaxis, 1=speedPenalty, 2=avoidance, 3=speedBoost
        if (entry.effect == 0) {
            chemotaxis += weighted;
        } else if (entry.effect == 1) {
            speedMod *= lerp(1.0, val, abs(entry.weight));
        } else if (entry.effect == 2) {
            avoidance += max(0, weighted);
        } else if (entry.effect == 3) {
            boost += max(0, weighted);
        }
    }

    // Habitat confinement: out-of-band permeability repels + slows this species (steer back
    // toward its termite-grown territory). Bands overlap across species -> soft borders.
    float habPerm = fieldRead.SampleLevel(sampler_fieldRead, float3(uv, CH_PERMEABILITY), 0);
    float outOfBand = max(0.0, habitatBandMin - habPerm) + max(0.0, habPerm - habitatBandMax);
    avoidance += outOfBand * habitatAvoidGain;
    // Floor the penalty so out-of-band agents slow but never fully freeze — termites must stay
    // mobile to build the walls that create their own in-band habitat (else init deadlocks).
    speedMod  *= max(habitatSpeedFloor, 1.0 - outOfBand * habitatSlowGain);

    perceptionTex[id.xy] = float4(
        saturate(chemotaxis * 0.5 + 0.5), // remap [-1,1] → [0,1]
        saturate(speedMod),
        saturate(avoidance),
        saturate(boost)                   // A = dispersal/speed-boost magnitude
    );
}


// ════════════════════════════════════════════════
// DEBUG RENDER
// ════════════════════════════════════════════════
[numthreads(8, 8, 1)]
void RenderDebugKernel(uint3 id : SV_DISPATCHTHREADID) {
    if (id.x >= rezX || id.y >= rezY) return;

    float val = fieldRead[uint3(id.xy, debugChannel)];
    if (debugNormalize != 0) val = saturate((val - debugNormMin) * debugNormInvRange);

    // Color-code by channel type
    float4 color;
    if (debugChannel == CH_NUTRIENT)         color = float4(0.2, 0.8, 0.2, 1) * val;  // green
    else if (debugChannel == CH_PHEROMONE0)  color = float4(0.8, 0.4, 0.8, 1) * val;  // purple
    else if (debugChannel == CH_PHEROMONE1)  color = float4(0.4, 0.8, 0.8, 1) * val;  // cyan
    else if (debugChannel == CH_PHEROMONE2)  color = float4(0.8, 0.2, 0.8, 1) * val;  // purple
    else if (debugChannel == CH_OXYGEN)      color = float4(0.3, 0.5, 1.0, 1) * val;  // blue
    else if (debugChannel == CH_TEMPERATURE) color = hsb2rgb(float3(0.0 + (1.0 - val) * 0.7, 0.8, val), 1); // heat map
    else if (debugChannel == CH_WASTE)       color = float4(0.6, 0.4, 0.1, 1) * val;  // brown
    else if (debugChannel == CH_PERMEABILITY) color = float4(val, val, val, 1);         // grayscale
    else if (debugChannel == CH_FLOW_X)      color = float4(val * 0.5 + 0.5, 0.2, 0.5 - val * 0.5, 1); // red-blue
    else if (debugChannel == CH_FLOW_Y)      color = float4(0.2, val * 0.5 + 0.5, 0.5 - val * 0.5, 1); // green-blue
    else if (debugChannel == CH_DISPERSAL)   color = float4(1.0, 0.5, 0.1, 1) * val;  // orange (agitation)
    else if (debugChannel == CH_HUMIDITY)    color = float4(0.1, 0.6, 0.9, 1) * val;  // teal (moisture)
    else if (debugChannel == CH_HUMIDITY_GRAD) color = float4(1.0, 0.85, 0.2, 1) * val; // amber (moisture edge)
    else color = float4(val, val, val, 1);

    debugOutTex[id.xy] = color;
}
