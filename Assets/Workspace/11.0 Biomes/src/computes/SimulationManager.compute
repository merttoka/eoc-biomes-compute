// Composite render: blend sim outputs into final output

#pragma kernel CompositeRenderKernel
#pragma kernel ResetTextureKernel
#pragma kernel NeuronRingKernel

uint rezX;
uint rezY;
uint simCount;

Texture2D<float4> simInput0;
Texture2D<float4> simInput1;
Texture2D<float4> simInput2;
Texture2D<float4> simInput3;
Texture2D<float4> simInput4;
Texture2D<float4> simInput5;
Texture2D<float4> simInput6;
Texture2D<float4> simInput7;

// Linear-clamp inline sampler: lets the composite UV-sample each sim's output so a sim
// can render at a LOWER internal resolution than this composite/output (e.g. sims at
// 1920×1080 → composite at 3840×1080). At equal resolution this samples texel centers
// and is identical to integer indexing. Decoupling sim res from output res is a 4× cost
// lever on diffuse/render/perception while preserving agent counts.
SamplerState sampler_linear_clamp;

Texture2D<float4> externalOverlay;
float overlayStrength;

// Per-sim composite weights (index matches simInput0..7 / simulations list).
StructuredBuffer<float> simWeights;

RWTexture2D<float4> compositeOut;

// Neuron firing-ring overlay: one count-independent marker per firing neuron.
StructuredBuffer<float>  ringFiring;     // per-neuron intensity (decayed)
StructuredBuffer<float2> ringPositions;  // normalized 0..1 (y-flipped), same CSV as sims
int    ringCount;
float  ringThreshold;
float2 ringSpawnScale;   // match the sims' spawnScale so rings land on agent clusters
float  ringRadius;       // pixels
float  ringThickness;    // pixels (gaussian sigma of the ring band)
float  ringStrength;
float4 ringColor;

float4 SampleSim(uint index, float2 uv) {
    if (index == 0) return simInput0.SampleLevel(sampler_linear_clamp, uv, 0);
    if (index == 1) return simInput1.SampleLevel(sampler_linear_clamp, uv, 0);
    if (index == 2) return simInput2.SampleLevel(sampler_linear_clamp, uv, 0);
    if (index == 3) return simInput3.SampleLevel(sampler_linear_clamp, uv, 0);
    if (index == 4) return simInput4.SampleLevel(sampler_linear_clamp, uv, 0);
    if (index == 5) return simInput5.SampleLevel(sampler_linear_clamp, uv, 0);
    if (index == 6) return simInput6.SampleLevel(sampler_linear_clamp, uv, 0);
    if (index == 7) return simInput7.SampleLevel(sampler_linear_clamp, uv, 0);
    return float4(0, 0, 0, 0);
}

[numthreads(8, 8, 1)]
void CompositeRenderKernel(uint3 id : SV_DISPATCHTHREADID) {
    if (id.x >= rezX || id.y >= rezY) return;

    float2 uv = (float2(id.xy) + 0.5) / float2((float)rezX, (float)rezY);
    float4 color = float4(0, 0, 0, 1);
    for (uint i = 0; i < simCount; i++) {
        float4 simColor = SampleSim(i, uv);
        // Weighted additive blend
        color.rgb += simColor.rgb * simWeights[i];
    }
    // Overlay external input
    if (overlayStrength > 0.0)
    {
        float4 overlay = externalOverlay[id.xy];
        color.rgb = lerp(color.rgb, overlay.rgb, overlayStrength * overlay.a);
    }

    compositeOut[id.xy] = saturate(color);
}

[numthreads(8, 8, 1)]
void ResetTextureKernel(uint3 id : SV_DISPATCHTHREADID) {
    if (id.x >= rezX || id.y >= rezY) return;
    compositeOut[id.xy] = float4(0, 0, 0, 1);
}

// Draw a soft ring at each firing neuron, additively, on top of the composite.
// Count-independent: one ring per neuron, brightness/radius scale with firing intensity.
[numthreads(8, 8, 1)]
void NeuronRingKernel(uint3 id : SV_DISPATCHTHREADID) {
    if (id.x >= rezX || id.y >= rezY) return;

    float2 px = float2(id.xy) + 0.5;
    float2 rez = float2((float)rezX, (float)rezY);
    float t = max(ringThickness, 0.5);
    float3 add = float3(0, 0, 0);

    for (int k = 0; k < ringCount; k++) {
        float f = ringFiring[k];
        if (f < ringThreshold) continue;
        // Same transform the sims use to place agents: normalized * spawnScale, centered.
        float2 np = ringPositions[k] * ringSpawnScale + (1.0 - ringSpawnScale) * 0.5;
        float2 npix = np * rez;
        float d = distance(px, npix);
        float r = ringRadius * (0.6 + 0.4 * saturate(f));      // radius pulses with intensity
        float band = exp(-((d - r) * (d - r)) / (2.0 * t * t)); // gaussian ring
        add += ringColor.rgb * band * saturate(f) * ringStrength;
    }

    float4 c = compositeOut[id.xy];
    c.rgb = saturate(c.rgb + add);
    compositeOut[id.xy] = c;
}
