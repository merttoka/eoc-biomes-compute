// Composite render: blend sim outputs into final output

#pragma kernel CompositeRenderKernel
#pragma kernel ResetTextureKernel
#pragma kernel MoundOverlayKernel

uint rezX;
uint rezY;
uint simCount;

Texture2D<float4> simInput0;
Texture2D<float4> simInput1;
Texture2D<float4> simInput2;
Texture2D<float4> simInput3;
Texture2D<float4> simInput4;
Texture2D<float4> simInput5;
Texture2D<float4> simInput6;
Texture2D<float4> simInput7;

// Linear-clamp inline sampler: lets the composite UV-sample each sim's output so a sim
// can render at a LOWER internal resolution than this composite/output (e.g. sims at
// 1920×1080 → composite at 3840×1080). At equal resolution this samples texel centers
// and is identical to integer indexing. Decoupling sim res from output res is a 4× cost
// lever on diffuse/render/perception while preserving agent counts.
SamplerState sampler_linear_clamp;

Texture2D<float4> externalOverlay;
float overlayStrength;

// Per-sim composite weights (index matches simInput0..7 / simulations list).
StructuredBuffer<float> simWeights;

RWTexture2D<float4> compositeOut;

#include "includes/keepout.hlsl"

float4 SampleSim(uint index, float2 uv) {
    // Initialize-first, no early returns: Metal's cross-compiled return slot trips a
    // "potentially uninitialized" warning on the early-return chain even with a
    // trailing fallback, so the branches assign into an already-initialized value.
    float4 c = float4(0, 0, 0, 0);
    if      (index == 0) c = simInput0.SampleLevel(sampler_linear_clamp, uv, 0);
    else if (index == 1) c = simInput1.SampleLevel(sampler_linear_clamp, uv, 0);
    else if (index == 2) c = simInput2.SampleLevel(sampler_linear_clamp, uv, 0);
    else if (index == 3) c = simInput3.SampleLevel(sampler_linear_clamp, uv, 0);
    else if (index == 4) c = simInput4.SampleLevel(sampler_linear_clamp, uv, 0);
    else if (index == 5) c = simInput5.SampleLevel(sampler_linear_clamp, uv, 0);
    else if (index == 6) c = simInput6.SampleLevel(sampler_linear_clamp, uv, 0);
    else if (index == 7) c = simInput7.SampleLevel(sampler_linear_clamp, uv, 0);
    return c;
}

[numthreads(8, 8, 1)]
void CompositeRenderKernel(uint3 id : SV_DISPATCHTHREADID) {
    if (id.x >= rezX || id.y >= rezY) return;

    float2 uv = (float2(id.xy) + 0.5) / float2((float)rezX, (float)rezY);
    float4 color = float4(0, 0, 0, 1);
    for (uint i = 0; i < simCount; i++) {
        float4 simColor = SampleSim(i, uv);
        // Weighted additive blend
        color.rgb += simColor.rgb * simWeights[i];
    }
    // Overlay external input
    if (overlayStrength > 0.0)
    {
        float4 overlay = externalOverlay[id.xy];
        color.rgb = lerp(color.rgb, overlay.rgb, overlayStrength * overlay.a);
    }

    // Mask screen cutouts last so every layer honors the physical hole, even a
    // stray agent that beat the steering.
    color.rgb *= 1.0 - KeepOutField(uv);
    compositeOut[id.xy] = saturate(color);
}

[numthreads(8, 8, 1)]
void ResetTextureKernel(uint3 id : SV_DISPATCHTHREADID) {
    if (id.x >= rezX || id.y >= rezY) return;
    compositeOut[id.xy] = float4(0, 0, 0, 1);
}

// Paint the termite-built walls (low permeability) over the composite, independent of the
// additive sim blend. wall-ness = (baseline - perm)/baseline, so open ground reads 0.
Texture2DArray<float> permField;
int   permChannel;         // BiomeChannel.Permeability
float permOpenBaselineOv;  // "open" value; wall-ness = (baseline - perm)/baseline
float moundStrength;
float4 moundColor;

[numthreads(8, 8, 1)]
void MoundOverlayKernel(uint3 id : SV_DISPATCHTHREADID) {
    uint w, h; compositeOut.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;
    float2 uv = (float2(id.xy) + 0.5) / float2(w, h);
    // Bilinear+clamp (built-in sampler) so the low-res permeability field upsamples smoothly
    // to the composite instead of point-sampling into blocky/aliased walls.
    float perm = permField.SampleLevel(sampler_linear_clamp, float3(uv, permChannel), 0);
    float wall = saturate((permOpenBaselineOv - perm) / max(1e-4, permOpenBaselineOv));  // 0 open, 1 solid
    wall = smoothstep(0.0, 1.0, wall);   // soften the wall edge
    wall *= 1.0 - KeepOutField(uv);      // mounds never paint into a screen cutout
    float4 c = compositeOut[id.xy];
    c.rgb = lerp(c.rgb, moundColor.rgb, wall * moundStrength);
    compositeOut[id.xy] = c;
}
