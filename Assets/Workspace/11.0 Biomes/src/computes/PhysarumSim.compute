// Physarum simulation with biome perception integration

#pragma kernel ResetTextureKernel
#pragma kernel ResetAgentsKernel
#pragma kernel MoveAgentsKernel
#pragma kernel WriteTrailsKernel
#pragma kernel DiffuseTextureKernel
#pragma kernel RenderKernel

// Trail texture array: layers 0..typeCount-1 = per-type, layer typeCount = total
SamplerState sampler_trailRead;
Texture2DArray<float> trailRead;
RWTexture2DArray<float> trailWrite;
RWTexture2D<float4> outTex;

// Coherence-enhancing trail diffusion (see DiffuseTextureKernel).
float trailAnisotropy;       // 0 = legacy isotropic box blur

// Biome perception: R=chemotaxis, G=speed multiplier, B=avoidance, A=speed boost (Dispersal)
Texture2D<float4> perceptionTex;
SamplerState sampler_perceptionTex;

struct Agent {
    float2 position;
    float2 direction;
    uint typeId;
};
uint agentsCount;
StructuredBuffer<Agent> agentsIn;
RWStructuredBuffer<Agent> agentsOut;

// Optional external initialization positions (e.g., neuron coordinates from CSV)
StructuredBuffer<float2> neuronPositions;
uint neuronCount;
float2 neuronScale; // how much of the canvas neurons fill (0-1), e.g. (0.8, 0.9)

uint rezX;
uint rezY;
uint time;
float persistence;   // per-frame retention of outTex (set from SimulationBase.renderPersistence)

#include "includes/random.hlsl"
#include "includes/physarum_type_params.hlsl"
#include "includes/neuron_layout.hlsl"
#include "includes/neuron_firing.hlsl"
#include "includes/dispersal_speed_response.hlsl"


// ════════════════════════════════════════════════
// RESET
// ════════════════════════════════════════════════
[numthreads(8, 8, 1)]
void ResetTextureKernel(uint3 id : SV_DISPATCHTHREADID) {
    if (id.x >= rezX || id.y >= rezY) return;
    for (uint t = 0; t <= typeCount; t++) {
        trailWrite[uint3(id.xy, t)] = 0;
    }
}

[numthreads(1024, 1, 1)]
void ResetAgentsKernel(uint3 id : SV_DISPATCHTHREADID) {
    if (id.x >= agentsCount) return;

    Agent a;

    if (neuronCount > 0) {
        uint idx = id.x % neuronCount;
        float2 p = NeuronPxToFieldPx(neuronPositions[idx], neuronScale, float2(rezX, rezY));
        p.x = clamp(p.x, 0.0, (float)rezX - 1.0);
        p.y = clamp(p.y, 0.0, (float)rezY - 1.0);
        a.position = p;
    } else {
        float2 c = Random2(id.x * .0001 + time * .001);
        a.position = float2(c.x * (float)rezX, c.y * (float)rezY);
    }

    a.direction = RandomDirection2(id.xy * .001 + sin(time));
    a.typeId = (id.x * typeCount) / agentsCount;
    agentsOut[id.x] = a;
}


// ════════════════════════════════════════════════
// SENSOR + MOVEMENT (with biome perception)
// ════════════════════════════════════════════════
float2 RotateVectorBy(float2 vec, float angle) {
    float x = vec.x * cos(angle) - vec.y * sin(angle);
    float y = vec.x * sin(angle) + vec.y * cos(angle);
    return float2(x, y);
}

float2 SensorTurns(uint3 id, Agent a, PhysarumTypeParams p) {
    float2 direction = normalize(a.direction);
    float r = p.senseDistance;
    float ang = p.senseAngle;
    float tang = p.turnAngle;

    float2 leftSensor = RotateVectorBy(direction, -ang) * r;
    float2 middleSensor = direction * r;
    float2 rightSensor = RotateVectorBy(direction, ang) * r;

    float2 leftCoord = a.position + leftSensor;
    float2 middleCoord = a.position + middleSensor;
    float2 rightCoord = a.position + rightSensor;

    float3 leftUV = float3(leftCoord.x / (float)rezX, leftCoord.y / (float)rezY, 0);
    float3 middleUV = float3(middleCoord.x / (float)rezX, middleCoord.y / (float)rezY, 0);
    float3 rightUV = float3(rightCoord.x / (float)rezX, rightCoord.y / (float)rezY, 0);

    // Own-type trail (intra-species)
    float myLeft = trailRead.SampleLevel(sampler_trailRead, float3(leftUV.xy, a.typeId), 0);
    float totLeft = trailRead.SampleLevel(sampler_trailRead, float3(leftUV.xy, typeCount), 0);
    float leftLevel = myLeft - (totLeft - myLeft);

    float myMiddle = trailRead.SampleLevel(sampler_trailRead, float3(middleUV.xy, a.typeId), 0);
    float totMiddle = trailRead.SampleLevel(sampler_trailRead, float3(middleUV.xy, typeCount), 0);
    float middleLevel = myMiddle - (totMiddle - myMiddle);

    float myRight = trailRead.SampleLevel(sampler_trailRead, float3(rightUV.xy, a.typeId), 0);
    float totRight = trailRead.SampleLevel(sampler_trailRead, float3(rightUV.xy, typeCount), 0);
    float rightLevel = myRight - (totRight - myRight);

    // Add biome perception (inter-species chemotaxis from environment)
    // perceptionTex.R = chemotaxis signal (0.5 = neutral, >0.5 = attractive, <0.5 = repulsive)
    float4 pL = perceptionTex.SampleLevel(sampler_perceptionTex, leftUV.xy, 0);
    float4 pM = perceptionTex.SampleLevel(sampler_perceptionTex, middleUV.xy, 0);
    float4 pR = perceptionTex.SampleLevel(sampler_perceptionTex, rightUV.xy, 0);

    // Combine: own trail + biome gradient (R chemotaxis) minus B avoidance
    leftLevel += (pL.r - 0.5) * 2.0 - pL.b;
    middleLevel += (pM.r - 0.5) * 2.0 - pM.b;
    rightLevel += (pR.r - 0.5) * 2.0 - pR.b;

    float2 d = direction;
    if (middleLevel > leftLevel && middleLevel > rightLevel) {
        d = middleSensor;
    } else if (middleLevel < leftLevel && middleLevel < rightLevel) {
        int sign = Random2(id.xy * .01 + sin(time) * .01).x <= 0.5 ? 1 : -1;
        d = RotateVectorBy(d, sign * tang);
    } else if (leftLevel < rightLevel) {
        d = RotateVectorBy(d, tang);
    } else if (leftLevel > rightLevel) {
        d = RotateVectorBy(d, -tang);
    } else {
        d = middleSensor;
    }

    return normalize(d);
}

[numthreads(1024, 1, 1)]
void MoveAgentsKernel(uint3 id : SV_DISPATCHTHREADID) {
    if (id.x >= agentsCount) return;

    Agent a = agentsIn[id.x];
    PhysarumTypeParams p = typeParams[a.typeId];

    float2 direction = SensorTurns(id, a, p);

    // Apply permeability speed penalty from biome; A = dispersal speed-boost magnitude.
    float2 uv = a.position / float2((float)rezX, (float)rezY);
    float4 perc = perceptionTex.SampleLevel(sampler_perceptionTex, uv, 0);
    float speedMult = perc.g;
    float disp = perc.a;
    float fireMul = IsFiring(id.x, neuronCount) ? p.firingSpeedMul : 1.0;
    float effectiveSpeed = p.moveSpeed * speedMult * fireMul;

    ApplyDispersalSpeedResponse(effectiveSpeed, disp);

    a.direction = direction * effectiveSpeed;
    a.position += a.direction;

    // Toroidal wrapping
    float fRezX = (float)rezX;
    float fRezY = (float)rezY;
    if (a.position.x < 0) a.position.x += fRezX;
    if (a.position.x >= fRezX) a.position.x -= fRezX;
    if (a.position.y < 0) a.position.y += fRezY;
    if (a.position.y >= fRezY) a.position.y -= fRezY;

    agentsOut[id.x] = a;
}


// ════════════════════════════════════════════════
// TRAILS
// ════════════════════════════════════════════════
[numthreads(1024, 1, 1)]
void WriteTrailsKernel(uint3 id : SV_DISPATCHTHREADID) {
    if (id.x >= agentsCount) return;

    Agent a = agentsOut[id.x];
    PhysarumTypeParams p = typeParams[a.typeId];
    uint2 pos = uint2(round(a.position));

    // Deposit into own layer (brighter when the agent's neuron is firing)
    float dep = IsFiring(id.x, neuronCount) ? p.firingDepositAmount : p.depositAmount;
    float own = trailWrite[uint3(pos, a.typeId)];
    trailWrite[uint3(pos, a.typeId)] = clamp(own + dep, 0, 1);

    // Eat from other layers. eatAmount == 0 changes nothing, so skip its
    // (typeCount-1) read-modify-writes per agent — at 10 M agents that's tens of
    // millions of incoherent memory transactions a step.
    if (p.eatAmount > 0) {
        for (uint t = 0; t < typeCount; t++) {
            if (t == a.typeId) continue;
            float other = trailWrite[uint3(pos, t)];
            trailWrite[uint3(pos, t)] = clamp(other - p.eatAmount, 0, 1);
        }
    }
}

// Coherence-enhancing anisotropic trail diffusion (structure tensor, à la Weickert):
// measure the local orientation of the TOTAL trail (layer typeCount) and elongate
// every type's 3x3 blur along the ridge axis — the tensor's minor eigenvector — by
// trailAnisotropy · coherence². A moving agent then leaves a crisp comet tail instead
// of a round bloom (slow agents no longer drown their short path in their own blur
// radius; measured on that case, trail width halves at full strength). Orientation
// derives from the trail itself, so it lives exactly as long as the trail — a
// separate heading field decays on the wrong timescale and measurably does nothing.
// Round blobs (stationary agents) and trail crossings have coherence ~0 → isotropic.
// The ridge AXIS is sign-free, matching the symmetric angular weight: the tail forms
// by retention, not drift. trailAnisotropy 0 → every weight 1 → the legacy box blur.
// Taps wrap toroidally: the trail textures are Repeat-wrapped and point-filtered, so
// integer modulo Loads reproduce the SampleLevel taps they replace — and match the
// agents' own wrapping.
[numthreads(8, 8, 1)]
void DiffuseTextureKernel(uint3 id : SV_DISPATCHTHREADID) {
    if (id.x >= rezX || id.y >= rezY) return;

    int2 rez = int2(rezX, rezY);

    // 5x5 cache of the total-trail layer -> central-difference gradients at the 3x3
    // window positions -> averaged structure tensor J = Σ g·gᵀ.
    float tot[25];
    {
        uint n = 0;
        for (int oy = -2; oy <= 2; oy++)
            for (int ox = -2; ox <= 2; ox++)
                tot[n++] = trailRead[uint3((int2(id.xy) + int2(ox, oy) + rez) % rez, typeCount)];
    }
    float jxx = 0, jxy = 0, jyy = 0;
    for (int wy = -1; wy <= 1; wy++) {
        for (int wx = -1; wx <= 1; wx++) {
            float gx = (tot[(wy + 2) * 5 + (wx + 3)] - tot[(wy + 2) * 5 + (wx + 1)]) * 0.5;
            float gy = (tot[(wy + 3) * 5 + (wx + 2)] - tot[(wy + 1) * 5 + (wx + 2)]) * 0.5;
            jxx += gx * gx; jxy += gx * gy; jyy += gy * gy;
        }
    }

    // Eigen-split: l1 >= l2; coherence ((l1-l2)/(l1+l2))² gates the elongation so only
    // clean ridges sharpen. Ridge axis = minor eigenvector = perp of the major one.
    float halfTr = (jxx + jyy) * 0.5;
    float det = sqrt(max(0.0, 0.25 * (jxx - jyy) * (jxx - jyy) + jxy * jxy));
    float l1 = halfTr + det, l2 = halfTr - det;
    float cohBase = (l1 + l2) > 1e-12 ? (l1 - l2) / (l1 + l2) : 0.0;
    float2 major = float2(jxy, l1 - jxx);
    if (abs(major.x) + abs(major.y) < 1e-12) major = float2(l1 - jyy, jxy);
    float mlen = length(major);
    float2 ridge = mlen > 1e-12 ? float2(-major.y, major.x) / mlen : float2(0, 0);
    float elong = (det > 1e-12 && mlen > 1e-12)
        ? trailAnisotropy * cohBase * cohBase : 0.0;

    int2  taps[9];
    float wts[9];
    float wsum = 0;
    uint k = 0;
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            taps[k] = (int2(id.xy) + int2(dx, dy) + rez) % rez;
            float a = 1.0;   // center tap: never down-weighted (wsum >= 1)
            if (dx != 0 || dy != 0) {
                float al = dot(normalize(float2(dx, dy)), ridge);
                float al2 = al * al;
                a = al2 * al2;   // ^4 lobe: halves the diagonal side-leak vs ^2
            }
            wts[k] = lerp(1.0, a, elong);
            wsum += wts[k];
            k++;
        }
    }

    float total = 0;
    for (uint t = 0; t < typeCount; t++) {
        float acc = 0;
        [unroll]
        for (uint i = 0; i < 9; i++)
            acc += wts[i] * trailRead[uint3(taps[i], t)];
        float diffused = clamp(acc / wsum * typeParams[t].diffuseRate, 0, 1);
        trailWrite[uint3(id.xy, t)] = diffused;
        total += diffused;
    }
    trailWrite[uint3(id.xy, typeCount)] = total;
}


// ════════════════════════════════════════════════
// RENDER
// ════════════════════════════════════════════════
#include "includes/color.hlsl"

[numthreads(8, 8, 1)]
void RenderKernel(uint3 id : SV_DISPATCHTHREADID) {
    if (id.x >= rezX || id.y >= rezY) return;

    float4 color = 0;
    for (uint t = 0; t < typeCount; t++) {
        float val = trailRead[uint3(id.xy, t)];
        PhysarumTypeParams p = typeParams[t];
        color += hsb2rgb(float3(p.hue, p.saturation, 0.8 * val), val) / typeCount;
    }
    float4 current = outTex[id.xy];
    current += color;
    current *= persistence;
    outTex[id.xy] = saturate(current);
}
